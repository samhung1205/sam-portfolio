# Notion 文章同步（scripts/sync-notion.mjs）所需環境變數
# 本機測試：複製成 .env 後填入真值（.env 已被 gitignore，不會進版控）
# GitHub Actions：到 repo Settings → Secrets and variables → Actions 逐一新增同名 secret

# 到 https://www.notion.so/my-integrations 建立 internal integration 取得 token，
# 並記得在 Notion 的「Site Articles」資料庫頁面右上 ⋯ → Connections 加入該 integration
NOTION_TOKEN=

# Site Articles 資料庫 ID（本專案建立的資料庫為 1b03014710694ddaab6fd85f84ede018）
NOTION_DATABASE_ID=1b03014710694ddaab6fd85f84ede018

# ---- Cloudflare R2 圖床（選填）----
# 五個都填了才會上傳 R2；缺任何一個時，圖片會改存到 repo 的 assets/images/articles/
# R2_PUBLIC_URL 是 bucket 的公開網址，例如 https://pub-xxxxxxxx.r2.dev 或自訂網域
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
